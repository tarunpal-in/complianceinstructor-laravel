{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "complianceinstructor/platform",
    "type": "project",
    "description": "Compliance Instructor — continuing-education (CEU) training platform.",
    "keywords": [
        "laravel",
        "filament",
        "ceu",
        "training",
        "webinars"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.7",
        "filament/spatie-laravel-media-library-plugin": "^5.7",
        "laravel/cashier": "^16.7",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.48",
        "laravel/scout": "^11.6",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "paypal/paypal-server-sdk": "^2.4",
        "smalot/pdfparser": "^2.12",
        "socialiteproviders/microsoft": "^4.10",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-pdf": "^2.13",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-sitemap": "^8.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "./vendor/bin/pest --parallel"
        ],
        "test:serial": [
            "@php artisan config:clear --ansi",
            "./vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "./vendor/bin/pint"
        ],
        "lint:test": [
            "./vendor/bin/pint --test"
        ],
        "types": [
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "env:check": [
            "@php artisan app:production-check"
        ],
        "ci": [
            "@lint:test",
            "@types",
            "@env:check",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Format the codebase with Pint",
        "lint:test": "Check formatting without writing (CI)",
        "types": "Larastan level 6 static analysis",
        "test": "Run the Pest suite",
        "ci": "Everything CI runs, in order"
    }
}
