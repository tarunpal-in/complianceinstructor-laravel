APP_NAME="Compliance Instructor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ceu_platform
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Read-only WordPress/WooCommerce source for the one-off migration. Load the
# dump into its own schema (e.g. `mysql ci_legacy < complianceinstructor.sql`)
# and point these at it; leave LEGACY_DB_DATABASE empty off the migration host.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_DB_PREFIX=wp_

# Password hashing driver. "legacy" is bcrypt plus the ability to verify
# imported WordPress hashes (so migrated users never reset); set "bcrypt" to
# opt out.
HASH_DRIVER=legacy

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private learner content (recordings, transcripts, materials).
# Dev: leave as "local". Production: set to "r2" and fill the R2 block below.
WEBINAR_ASSETS_DISK=local

# Cloudflare R2 (S3-compatible, zero egress). From an R2 API token for the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_DEFAULT_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_USE_PATH_STYLE_ENDPOINT=false
# Leave blank for a private bucket (served via signed URLs); set only if fronted by a public domain.
R2_URL=

VITE_APP_NAME="${APP_NAME}"

# --- Payments (CLAUDE.md §8) -------------------------------------------------
# Never commit real values; the deploy pipeline injects them (§9).
# Stripe has no mode flag: test vs live is decided by the key prefix you paste
# (sk_test_… / pk_test_… for testing, sk_live_… / pk_live_… for production).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

# PayPal is the primary gateway. PAYPAL_MODE switches the whole integration
# between PayPal's sandbox and live environments (both the server API and the
# checkout buttons). Keep it "sandbox" for testing; set "live" only in
# production. The client id/secret MUST come from the matching PayPal app —
# sandbox credentials for sandbox, live credentials for live.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Observability (CLAUDE.md §11) -------------------------------------------
SENTRY_LARAVEL_DSN=

# --- PDF ---------------------------------------------------------------------
# spatie/laravel-pdf needs headless Chrome; dompdf is the documented fallback.
BROWSERSHOT_CHROME_PATH=
