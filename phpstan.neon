includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    level: 6

    paths:
        - app
        - config
        - database
        - routes

    # Larastan defaults this to empty, which means no string is ever recognised
    # as a view-string and every ->view('...') is reported as a type error.
    # Pointing it at the view root also buys real checking: a typo'd or deleted
    # Blade path becomes a build failure instead of a 500 on a page nobody
    # visited before the client did.
    viewDirectories:
        - resources/views

    # 'tests' is deliberately excluded: Pest binds its closures to Tests\TestCase
    # at runtime via pest()->extend(), which PHPStan cannot see, so every
    # $this->get() in a test would be a false positive. Pest is the gate on test code.

    # CLAUDE.md §9 — "Larastan and Pint in CI reject debug helpers; errors go to
    # log and Sentry, never the response." The predecessor shipped dd($e) in an
    # admin login catch block. This makes that a build failure, not a code review.
    disallowedFunctionCalls:
        - function: 'dd()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'dump()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'var_dump()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'print_r()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'ray()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'eval()'
          message: 'never'
        - function: 'exit()'
          message: 'throw or return a response instead'
        - function: 'die()'
          message: 'throw or return a response instead'


    # A role change must go through App\Support\RoleAssignment, which records
    # who made it. Roles live in a pivot table, and a pivot write fires no
    # Eloquent event — so LogsActivity on User never sees one and "who made
    # Marcus a Super Admin" has no answer. §8 requires every mutation in the
    # activity log with the actor; this is the one that needed help to get there.
    disallowedMethodCalls:
        - method: 'Spatie\Permission\Traits\HasRoles::syncRoles()'
          message: 'use App\Support\RoleAssignment::sync(), which records who changed it (CLAUDE.md §8)'
          allowIn:
              - app/Support/RoleAssignment.php
        - method: 'Spatie\Permission\Traits\HasRoles::assignRole()'
          message: 'use App\Support\RoleAssignment::sync(), which records who changed it (CLAUDE.md §8)'
          allowIn:
              - app/Support/RoleAssignment.php
        - method: 'Spatie\Permission\Traits\HasRoles::removeRole()'
          message: 'use App\Support\RoleAssignment::sync(), which records who changed it (CLAUDE.md §8)'
          allowIn:
              - app/Support/RoleAssignment.php
