includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    level: 6

    paths:
        - app
        - config
        - database
        - routes

    # Larastan defaults this to empty, which means no string is ever recognised
    # as a view-string and every ->view('...') is reported as a type error.
    # Pointing it at the view root also buys real checking: a typo'd or deleted
    # Blade path becomes a build failure instead of a 500 on a page nobody
    # visited before the client did.
    viewDirectories:
        - resources/views

    # 'tests' is deliberately excluded: Pest binds its closures to Tests\TestCase
    # at runtime via pest()->extend(), which PHPStan cannot see, so every
    # $this->get() in a test would be a false positive. Pest is the gate on test code.

    # CLAUDE.md §9 — "Larastan and Pint in CI reject debug helpers; errors go to
    # log and Sentry, never the response." The predecessor shipped dd($e) in an
    # admin login catch block. This makes that a build failure, not a code review.
    disallowedFunctionCalls:
        - function: 'dd()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'dump()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'var_dump()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'print_r()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'ray()'
          message: 'log it or use Debugbar; never ship a debug helper (CLAUDE.md §9)'
        - function: 'eval()'
          message: 'never'
        - function: 'exit()'
          message: 'throw or return a response instead'
        - function: 'die()'
          message: 'throw or return a response instead'


    # Every email goes through App\Email\Dispatcher, which writes its row in
    # `email_sends` before anything reaches a mail server. §14 #6 is a customer
    # charged who "received nothing, with no record written" — and the half people
    # skip is the second half. Without this ban the Dispatcher is a convention,
    # and the first person in a hurry sends straight from an action and puts a
    # hole in the log that nobody notices until a customer says they never got it.
    disallowedStaticCalls:
        - method: 'Illuminate\Support\Facades\Mail::to()'
          message: 'send it through App\Email\Dispatcher, so it is recorded in the email log'
          allowIn:
              - app/Jobs/SendEmail.php
        - method: 'Illuminate\Support\Facades\Mail::send()'
          message: 'send it through App\Email\Dispatcher, so it is recorded in the email log'
          allowIn:
              - app/Jobs/SendEmail.php
        - method: 'Illuminate\Support\Facades\Mail::queue()'
          message: 'send it through App\Email\Dispatcher, so it is recorded in the email log'
        - method: 'Illuminate\Support\Facades\Mail::raw()'
          message: 'send it through App\Email\Dispatcher, so it is recorded in the email log'
        - method: 'Illuminate\Support\Facades\Mail::html()'
          message: 'send it through App\Email\Dispatcher, so it is recorded in the email log'
        - method: 'Illuminate\Support\Facades\Notification::send()'
          message: 'send it through App\Email\Dispatcher as a LoggedMail, so it is recorded in the email log'
        - method: 'Illuminate\Support\Facades\Notification::route()'
          message: 'send it through App\Email\Dispatcher as a LoggedMail, so it is recorded in the email log'

    disallowedMethodCalls:
        - method: 'Spatie\Permission\Traits\HasRoles::syncRoles()'
          message: 'use App\Support\RoleAssignment::sync(), which records who changed it (CLAUDE.md §8)'
          allowIn:
              - app/Support/RoleAssignment.php
        - method: 'Spatie\Permission\Traits\HasRoles::assignRole()'
          message: 'use App\Support\RoleAssignment::sync(), which records who changed it (CLAUDE.md §8)'
          allowIn:
              - app/Support/RoleAssignment.php
        - method: 'Spatie\Permission\Traits\HasRoles::removeRole()'
          message: 'use App\Support\RoleAssignment::sync(), which records who changed it (CLAUDE.md §8)'
          allowIn:
              - app/Support/RoleAssignment.php
        # Mail sent as a notification bypasses the log the same way. Laravel's own
        # password-reset notification is the one exception the application cannot
        # avoid, and AppServiceProvider intercepts it rather than letting it send.
        - method: 'Illuminate\Notifications\Notifiable::notify()'
          message: 'send it through App\Email\Dispatcher as a LoggedMail, so it is recorded in the email log'
        - method: 'Illuminate\Notifications\Notifiable::notifyNow()'
          message: 'send it through App\Email\Dispatcher as a LoggedMail, so it is recorded in the email log'
